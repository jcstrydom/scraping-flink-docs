select	 a.version
		,count(1) as row_count
from pages a
group by a.version
order by a.version 
;




select 	 a.*
from pages a
where a.page_id = '73d23196b50c63b196712c17487124bc55f3b042e211d1c7a1a01c9d039c0a96'
;



with cnts_base as (
	select	 length(a.summary) as sum_length
			,(length(a.summary) - length(replace(a.summary,' ',''))) as sum_space_count
			,length(a.slug) as slug_length
			,(length(a.slug) - length(replace(a.slug,' ',''))) as slug_space_count
			,(case when a.headings = '[]' then 1 else 0 end) as empty_headings_count
			,a.*
	from pages a
)
select  a.*
from cnts_base a
where a.empty_headings_count &gt; 0





